{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "test/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "playwright.security.config.ts",
    "vitest.config.ts"
  ]
}
